{
  "name": "@sinkapoy/home-core",
  "version": "1.1.0",
  "description": "home core package",
  "main": "dist/core.js",
  "type": "module",
  "browser": "dist/core.js",
  "typings": "dist/core.d.ts",
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript && dts-bundle-generator -o dist/core.d.ts --project tsconfig.json src/index.ts",
    "generateTypes": "dts-bundle-generator -o dist/core.d.ts --project tsconfig.json src/index.ts",
    "watch": "rollup -c rollup.config.ts --watch --configPlugin @rollup/plugin-typescript",
    "lint": "npx eslint \"src/**/*.{js,ts,vue,json}\" --fix"
  },
  "keywords": [
    "typescript"
  ],
  "author": "sinkapoy",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@stylistic/eslint-plugin": "^5.1.0",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.2.0",
    "rollup": "^4.40.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-replace-style-inject": "^1.0.6",
    "rollup-plugin-styler": "^2.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-vue": "^6.0.0",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.35.1",
    "vue-eslint-parser": "^10.1.4"
  },
  "dependencies": {
    "@ash.ts/ash": "^1.3.0",
    "eventemitter3": "^5.0.1",
    "jose": "^6.1.0",
    "otplib": "^12.0.1"
  },
  "files": [
    "dist/src",
    "dist/core.js",
    "dist/core.map"
  ]
}
