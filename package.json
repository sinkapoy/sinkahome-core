{
  "name": "@sinkapoy/home-core",
  "version": "0.3.0",
  "description": "home core package",
  "main": "dist/core.js",
  "type": "module",
  "browser": "dist/core.js",
  "typings": "dist/core.d.ts",
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript && dts-bundle-generator -o dist/core.d.ts --project tsconfig.json src/index.ts",
    "generateTypes": "dts-bundle-generator -o dist/core.d.ts --project tsconfig.json src/index.ts",
    "watch": "rollup -c rollup.config.ts --watch --configPlugin @rollup/plugin-typescript",
    "lint": "npx eslint \"src/**/*.{js,ts,vue,json}\" --fix"
  },
  "keywords": [
    "typescript"
  ],
  "author": "sinkapoy",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@stylistic/eslint-plugin": "^1.7.0",
    "@stylistic/eslint-plugin-ts": "^4.1.0",
    "@types/node": "^22.13.8",
    "@vue/eslint-config-typescript": "^14.4.0",
    "dts-bundle-generator": "^8.0.1",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.0.0",
    "rollup": "^4.34.9",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.0",
    "tsx": "^3.12.7",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.25.0"
  },
  "dependencies": {
    "@ash.ts/ash": "^1.3.0"
  },
  "files": [
    "dist/core.js",
    "dist/core.js.map",
    "dist/core.d.ts"
  ]
}
